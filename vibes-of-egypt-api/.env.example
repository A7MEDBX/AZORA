# Server Configuration (CORS_ORIGIN supports comma-separated origins)
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Supabase Configuration (used server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin JWT Authentication (signed & verified by vibes-of-egypt-api)
JWT_SECRET=replace-with-a-strong-random-64-char-secret-key-in-production
JWT_EXPIRES_IN=7d

# Optional Direct Admin Credentials (or create users via `npm run create-admin`)
ADMIN_EMAIL=admin@vibesofegypt.com
ADMIN_PASSWORD=

# Cloudinary Media Storage (server-side signed uploads & deletions)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
